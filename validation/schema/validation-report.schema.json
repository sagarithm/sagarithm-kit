{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SagarithmValidationReport",
  "description": "Standard schema for Sagarithm Kit verification gate and audit results",
  "type": "object",
  "required": ["version", "timestamp", "state", "summary", "vectors", "issues"],
  "properties": {
    "version": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "type": "string",
      "enum": ["ASSUMED", "IMPLEMENTED", "TESTED", "VERIFIED", "FAILED"]
    },
    "summary": {
      "type": "object",
      "required": ["totalChecks", "passed", "warnings", "errors"],
      "properties": {
        "totalChecks": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 }
      }
    },
    "vectors": {
      "type": "object",
      "properties": {
        "static": { "$ref": "#/definitions/VectorResult" },
        "security": { "$ref": "#/definitions/VectorResult" },
        "architecture": { "$ref": "#/definitions/VectorResult" },
        "behavioral": { "$ref": "#/definitions/VectorResult" },
        "documentation": { "$ref": "#/definitions/VectorResult" }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ruleId", "severity", "message", "remediation"],
        "properties": {
          "ruleId": { "type": "string" },
          "severity": { "type": "string", "enum": ["error", "warn", "advisory"] },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "message": { "type": "string" },
          "remediation": { "type": "string" }
        }
      }
    }
  },
  "definitions": {
    "VectorResult": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["passed", "failed", "skipped", "warn"] },
        "durationMs": { "type": "number" },
        "details": { "type": "string" }
      }
    }
  }
}
