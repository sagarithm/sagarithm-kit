{
  "name": "sagarithm-kit",
  "version": "1.0.1",
  "description": "Universal Cross-Agent Engineering Framework for AI Coding Agents",
  "type": "module",
  "bin": {
    "sagarithm": "./bin/sagarithm.mjs",
    "sagarithm-kit": "./bin/sagarithm.mjs"
  },
  "main": "./cli/dist/index.mjs",
  "files": [
    "bin",
    "cli/dist",
    "cli/package.json",
    "constitution",
    "skills",
    "policies",
    "workflows",
    "adapters",
    "registry",
    "context",
    "validation",
    "specification",
    "sagarithm.manifest.json",
    "README.md",
    "LICENSE",
    "ARCHITECTURE.md"
  ],
  "scripts": {
    "build": "esbuild cli/src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=cli/dist/index.mjs",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "start": "node ./bin/sagarithm.mjs",
    "test": "npm --prefix cli test",
    "lint": "node ./cli/dist/index.mjs audit",
    "verify": "node ./cli/dist/index.mjs verify",
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build"
  },
  "devDependencies": {
    "esbuild": "^0.25.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sagarithm/sagarithm-kit.git"
  },
  "keywords": [
    "sagarithm",
    "sagarithm-kit",
    "ai-agents",
    "coding-agents",
    "cross-agent",
    "cursor",
    "antigravity",
    "claude-code",
    "copilot",
    "windsurf",
    "engineering-framework"
  ],
  "author": "Sagarithm",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/sagarithm/sagarithm-kit/issues"
  },
  "homepage": "https://github.com/sagarithm/sagarithm-kit#readme"
}
