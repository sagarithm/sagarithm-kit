{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SagarithmPackageManifest",
  "description": "JSON schema for Sagarithm published skill or policy packages",
  "type": "object",
  "required": ["name", "version", "type", "description", "author", "license", "entrypoint"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^@?[a-z0-9-]+(/[a-z0-9-]+)?$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "type": {
      "type": "string",
      "enum": ["skill", "policy", "workflow", "pack"]
    },
    "domain": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "license": {
      "type": "string",
      "default": "Apache-2.0"
    },
    "integrity": {
      "type": "string",
      "pattern": "^sha256-[a-f0-9]{64}$"
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "policies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "entrypoint": {
      "type": "string"
    }
  }
}
